rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ACCESO TOTAL AL SILO DEL USUARIO (arquitectura actual, sin cambios)
    // Esta regla otorga permisos absolutos de lectura y escritura al dueño de la cuenta
    // en todas las profundidades de sus colecciones. Se conserva intacta: todos los
    // módulos existentes (agenda, expediente, odontograma, presupuestos, pagos, etc.)
    // siguen dependiendo de ella hasta que se migren a la capa multi-clínica.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Acceso al documento raíz del usuario
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ============================================================
    // CAPA MULTI-CLÍNICA (Fase 4, incremento 1 — sonrie-x-todos-dental)
    // ============================================================

    function memberDoc(clinicId) {
      return get(/databases/$(database)/documents/clinicMembers/$(clinicId + '_' + request.auth.uid));
    }
    function isActiveMember(clinicId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clinicMembers/$(clinicId + '_' + request.auth.uid))
        && memberDoc(clinicId).data.status == 'active';
    }
    function memberRole(clinicId) {
      return memberDoc(clinicId).data.role;
    }
    function isClinicAdmin(clinicId) {
      return isActiveMember(clinicId) && memberRole(clinicId) == 'admin';
    }
    function isClinician(clinicId) {
      return isActiveMember(clinicId) && memberRole(clinicId) in ['odontologo', 'admin'];
    }

    // MO: un colaborador puede tener limitado a cuáles recursos (médicos/
    // unidades) de la Agenda puede ver — configurado en Administración >
    // Colaboradores (campo recursosVisibles en clinicMembers). Ausente o
    // vacío = sin restricción (ve todos, comportamiento de siempre).
    function tieneAccesoACita(clinicId, citaData) {
      // .get(key, default) en vez de acceso directo (citaData.medicoId) a
      // propósito: una cita legada puede no tener alguno de estos campos
      // en absoluto (no solo en null), y el acceso directo a una llave
      // ausente truena la regla completa en vez de simplemente dar false.
      let limite = memberDoc(clinicId).data.get('recursosVisibles', []);
      let medicoId = citaData.get('medicoId', null);
      let unidadId = citaData.get('unidadId', null);
      let recursoId = citaData.get('recursoId', null);
      return isActiveMember(clinicId)
        && (limite.size() == 0
            || (medicoId != null && medicoId in limite)
            || (unidadId != null && unidadId in limite)
            || (recursoId != null && recursoId in limite));
    }

    // MO: verifica si hay una invitación pendiente reclamable para el correo
    // de la sesión actual, con el mismo rol que se está intentando auto-asignar.
    function existsClaimableInvite(clinicId, role) {
      return exists(/databases/$(database)/documents/clinicInvites/$(clinicId + '_' + request.auth.token.email))
        && get(/databases/$(database)/documents/clinicInvites/$(clinicId + '_' + request.auth.token.email)).data.status == 'pending'
        && get(/databases/$(database)/documents/clinicInvites/$(clinicId + '_' + request.auth.token.email)).data.role == role;
    }

    function linkDoc(clinicId) {
      return get(/databases/$(database)/documents/patientClinicLinks/$(clinicId + '_' + request.auth.uid));
    }
    function isLinkedPatient(clinicId) {
      return signedIn()
        && exists(/databases/$(database)/documents/patientClinicLinks/$(clinicId + '_' + request.auth.uid))
        && linkDoc(clinicId).data.status == 'active';
    }

    // Identidad general del paciente (uid propio == patientId). Solo lo lee/escribe
    // el propio paciente en este incremento; el acceso del staff de clínica se
    // habilitará cuando se construyan los expedientes por clínica (incremento 2).
    match /patients/{patientId} {
      allow read, write: if signedIn() && request.auth.uid == patientId;
    }

    match /clinics/{clinicId} {
      allow read: if isActiveMember(clinicId) || isLinkedPatient(clinicId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isClinicAdmin(clinicId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /clinicMembers/{memberId} {
      // OJO: esta regla NO puede depender de isClinicAdmin()/isActiveMember() aquí,
      // porque esas funciones hacen get() sobre la propia colección clinicMembers —
      // esa auto-referencia hace que Firestore rechace las consultas por lista
      // (where uid==, where clinicId==) con "Missing or insufficient permissions",
      // aunque el mismo get() sí funciona bien en reglas de otras colecciones.
      // Por eso aquí solo se valida por id/campos propios, y el "admin ve a todo
      // el equipo" se resuelve contra /clinics (colección distinta, sin auto-referencia).
      allow read: if signedIn()
        && (memberId.split('_')[1] == request.auth.uid
            || resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid);
      // Un admin ya existente puede invitar a cualquiera.
      // Bootstrap: el dueño de una clínica recién creada puede crear su ÚNICO
      // registro de miembro admin (atado al ownerId del doc de la clínica, nunca
      // a "si no hay miembros todavía" para evitar apropiaciones).
      // MO añade un tercer caso: quien se registra puede auto-crear su propia
      // membresía (de cualquier rol, incluido "admin" — ej. un segundo doctor
      // que debe ver finanzas) si existe una invitación pendiente que
      // coincide con su correo Y con ese rol exacto — así el colaborador
      // "reclama" el lugar que el dueño le dejó. El rol viene del invite
      // (creado solo por un admin existente), nunca de lo que el invitado
      // decida escribir, así que esto no permite auto-otorgarse admin.
      allow create: if isClinicAdmin(memberId.split('_')[0])
        || (signedIn()
            && memberId == memberId.split('_')[0] + '_' + request.auth.uid
            && request.resource.data.role == 'admin'
            && get(/databases/$(database)/documents/clinics/$(memberId.split('_')[0])).data.ownerId == request.auth.uid)
        || (signedIn()
            && memberId == memberId.split('_')[0] + '_' + request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && existsClaimableInvite(memberId.split('_')[0], request.resource.data.role));
      // Un admin puede modificar cualquier membresía de su clínica.
      // El propio invitado solo puede aceptar (cambiar status), nunca su rol.
      allow update: if isClinicAdmin(memberId.split('_')[0])
        || (memberId.split('_')[1] == request.auth.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == 'active');
      allow delete: if isClinicAdmin(memberId.split('_')[0]);
    }

    match /patientClinicLinks/{linkId} {
      allow read: if signedIn()
        && (linkId.split('_')[1] == request.auth.uid || isActiveMember(linkId.split('_')[0]));
      // El staff de la clínica puede crear/gestionar el vínculo.
      // El propio paciente puede solicitarlo (queda en estado "pending").
      allow write: if isActiveMember(linkId.split('_')[0])
        || (signedIn() && linkId.split('_')[1] == request.auth.uid && request.resource.data.status == 'pending');
    }

    // ============================================================
    // COLABORADORES DE CLÍNICA PARA MO (nuevo, aditivo)
    // Usa el uid del dueño como clinicId (sin necesitar bootstrap de /clinics
    // salvo el doc mínimo con ownerId), reutilizando clinicMembers de arriba.
    // Acceso operativo del día a día para cualquier miembro activo; las
    // subcolecciones financieras (pagos) quedan reservadas solo para admins.
    // ============================================================

    match /clinicInvites/{inviteId} {
      allow read: if isClinicAdmin(inviteId.split('_')[0])
        || isClinicAdmin(resource.data.clinicId)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create, delete: if isClinicAdmin(inviteId.split('_')[0]);
      // El admin puede editar libremente; quien reclama la invitación solo
      // puede marcarla como 'claimed', sin tocar clínica/rol/correo.
      allow update: if isClinicAdmin(inviteId.split('_')[0])
        || (signedIn()
            && resource.data.email == request.auth.token.email
            && request.resource.data.status == 'claimed'
            && request.resource.data.email == resource.data.email
            && request.resource.data.clinicId == resource.data.clinicId
            && request.resource.data.role == resource.data.role);
    }

    match /users/{ownerId}/pacientes/{patientId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/presupuestos/{budgetId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/recetas/{recetaId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/notasEvolucion/{notaId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/diagnosticos/{diagnosticoId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/planTratamiento/{planTratamientoItemId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/comparativas/{comparativaId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/pagos/{pagoId} {
      allow read, write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/devoluciones/{devolucionId} {
      allow read, write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/devolucionesResumen/{pagoId} {
      allow read, write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/recursos/{recursoId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/citas/{citaId} {
      allow read, update, delete: if tieneAccesoACita(ownerId, resource.data);
      allow create: if tieneAccesoACita(ownerId, request.resource.data);
    }
    match /users/{ownerId}/config/{configId} {
      allow read: if isActiveMember(ownerId);
      allow write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/membresiaPlanes/{planId} {
      allow read: if isActiveMember(ownerId);
      allow write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/membresias/{membershipId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/personalAsistencia/{personalId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/registrosAsistencia/{registroId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/procedimientos/{procedimientoId} {
      allow read: if isActiveMember(ownerId);
      allow write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/historiaClinica/{docId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pacientes/{patientId}/fotos/{docId} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/medicamentos/{medicamentoId} {
      allow read: if isActiveMember(ownerId);
      allow write: if isClinicAdmin(ownerId);
    }

    // Colecciones operativas (no financieras) que faltaban aquí — sin esto,
    // un colaborador (incluso rol "admin") recibía "permission-denied" al
    // entrar a estos módulos, porque no calzaban con ninguna regla de arriba
    // y caían en la regla base de users/{userId}/** (solo el dueño).
    match /users/{ownerId}/depositosDentales/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/articulosFaltantes/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/articulosCaducidad/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/centrosRadiodiagnostico/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/laboratoriosDentales/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/laminas/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/encuestas/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/domiciliaciones/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/promociones/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/aseguradoras/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/empresasRpbi/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/contadores/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/otsLog/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/presupuestosLog/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/recetasLog/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    match /users/{ownerId}/pendientes/{id} {
      allow read, write: if isActiveMember(ownerId);
    }
    // Financiero — mismo criterio que pagos: solo admin.
    match /users/{ownerId}/pagosEliminados/{id} {
      allow read, write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/gastos/{id} {
      allow read, write: if isClinicAdmin(ownerId);
    }
    match /users/{ownerId}/devolucionesLog/{id} {
      allow read, write: if isClinicAdmin(ownerId);
    }

    // ============================================================
    // PANEL DE ADMINISTRADOR (cross-clínica, solo para el dueño de la
    // plataforma) — nunca se abre lectura/escritura de cliente aquí; todo
    // pasa por /api/admin/* y /api/sugerencias usando Firebase Admin SDK
    // (bypassa estas reglas), que verifica el ID token en servidor contra
    // ADMIN_UID. Mantener esta colección cerrada por completo desde el
    // cliente es más simple y más seguro que dar una excepción de UID aquí.
    // ============================================================
    match /sugerenciasPlataforma/{id} {
      allow read, write: if false;
    }

    // ============================================================
    // MO CONECTA — red profesional de interconsultas entre odontólogos
    // (cross-clínica, aditivo, aislado del resto de la app).
    //
    // Principio de menor privilegio absoluto: NINGUNA colección de aquí
    // abajo admite escritura desde el cliente — todo pasa por
    // /api/conecta/* y /api/admin/conecta/* usando Firebase Admin SDK
    // (bypassa estas reglas), igual que el Panel de administrador arriba.
    // El cliente únicamente lee, en tiempo real, lo que ya le corresponde
    // como dueño/participante — nunca escribe directo, ni siquiera su
    // propio perfil.
    // ============================================================

    function esParticipanteInterconsulta(interconsultaId) {
      return signedIn()
        && request.auth.uid in
           get(/databases/$(database)/documents/interconsultas/$(interconsultaId)).data.participantesAutorizados;
    }

    match /perfilesProfesionalesPublicos/{uid} {
      allow read: if signedIn(); // directorio — visible a cualquier odontólogo autenticado
      allow write: if false;     // solo POST/PATCH /api/conecta/perfiles
    }
    match /perfilesProfesionalesPrivados/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /perfilesProfesionalesAdmin/{uid} {
      allow read, write: if false; // ni el propio dueño — solo dbAdmin
    }

    match /afiliaciones/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isClinicAdmin(resource.data.clinicaId));
      allow write: if false; // solo /api/conecta/afiliaciones
    }

    match /interconsultas/{id} {
      // OJO: aquí se compara request.auth.uid contra resource.data
      // directamente (no esParticipanteInterconsulta(), que hace un get()
      // extra sobre este MISMO documento) — con una consulta de lista
      // (MoConectaContext.tsx filtra con array-contains sobre esta
      // colección), un get() propio dentro de la regla hace que Firestore
      // rechace la consulta completa con "permission-denied", incluso con
      // la colección vacía. Comparar directo contra resource.data sí es
      // válido para listas.
      allow read: if signedIn() && request.auth.uid in resource.data.participantesAutorizados;
      allow write: if false; // solo /api/conecta/interconsultas/*
    }
    match /interconsultas/{id}/mensajes/{msgId} {
      allow read: if esParticipanteInterconsulta(id);
      allow write: if false;
    }
    match /interconsultas/{id}/eventos/{eventoId} {
      allow read: if esParticipanteInterconsulta(id);
      allow write: if false; // auditoría — inmutable, nunca desde el cliente
    }
    match /interconsultas/{id}/solicitudesAcceso/{solicitudId} {
      allow read: if esParticipanteInterconsulta(id)
        || (signedIn() && resource.data.solicitanteUid == request.auth.uid);
      allow write: if false;
    }

    match /consentimientosInterconsulta/{id} {
      allow read: if signedIn() && resource.data.odontologoUid == request.auth.uid;
      allow write: if false; // documento original inmutable — solo se crea/lee vía servidor
    }
    match /consentimientosInterconsulta/{id}/revocaciones/{revId} {
      allow read: if signedIn()
        && get(/databases/$(database)/documents/consentimientosInterconsulta/$(id)).data.odontologoUid == request.auth.uid;
      allow write: if false;
    }

    match /invitacionesConecta/{id} {
      allow read, write: if false; // nunca desde el cliente — todo pasa por /api/conecta/invitaciones/*
    }
    match /eventosCrecimientoConecta/{id} {
      allow read, write: if false; // solo superadmin vía dbAdmin
    }
    match /configuracionConecta/{id} {
      allow read: if signedIn(); // transparencia — cualquiera puede ver la política vigente
      allow write: if false;     // solo /api/admin/conecta/*
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
