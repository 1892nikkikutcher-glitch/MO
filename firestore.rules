rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Silo por usuario: cada cuenta lee/escribe únicamente sus propios datos
    // (pacientes, recursos, citas, presupuestos, pagos), igual que en
    // sonrie-x-todos-dental.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
