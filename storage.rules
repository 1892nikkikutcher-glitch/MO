rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Quién es quién en una clínica (la misma colección clinicMembers que usa firestore.rules; el
    // dueño de la clínica es quien tiene uid == clinicId).
    function esDuenoDeClinica(clinicId) {
      return request.auth != null && request.auth.uid == clinicId;
    }
    function miembro(clinicId) {
      return firestore.get(/databases/(default)/documents/clinicMembers/$(clinicId + '_' + request.auth.uid));
    }
    function esMiembroActivo(clinicId) {
      return esDuenoDeClinica(clinicId)
        || (request.auth != null
            && firestore.exists(/databases/(default)/documents/clinicMembers/$(clinicId + '_' + request.auth.uid))
            && miembro(clinicId).data.status == 'active');
    }
    function esAdministrador(clinicId) {
      return esDuenoDeClinica(clinicId)
        || (esMiembroActivo(clinicId) && miembro(clinicId).data.role == 'admin');
    }

    // Fotos de pacientes (perfil, extraorales, intraorales, INE, radiografías): todo el equipo activo de la
    // clínica las ve y sube nuevas; reemplazar o borrar un archivo solo lo hace el administrador.
    match /users/{clinicId}/pacientes/{patientId}/fotos/{allPaths=**} {
      allow read, create: if esMiembroActivo(clinicId);
      // Pisar un archivo que ya existe cuenta como "update" en Cloud Storage: solo el administrador. Las fotos de MO siempre se
      // suben con un nombre nuevo, así que subir no necesita pisar nada.
      allow update, delete: if esAdministrador(clinicId);
    }

    // Firma de acuse de recepción de una devolución de pago (ver
    // firmaRecepcionDevolucion.ts) — mismo criterio que fotos/** arriba.
    match /users/{clinicId}/pacientes/{patientId}/devoluciones/{devolucionId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == clinicId;
    }

    // MO CONECTA — los archivos de una interconsulta viven en
    // `interconsultas/{id}/archivos/**`. A propósito NO tienen una regla
    // explícita aquí: quedan cubiertos por el "if false" de abajo. Todo el
    // acceso (subida y descarga) pasa por rutas de servidor con el Admin
    // SDK de Storage, que revisa `participantesAutorizados` en Firestore en
    // el momento de cada operación — así una revocación de acceso corta la
    // siguiente descarga de inmediato, sin depender de una URL residual
    // (ver §6 del plan de MO Conecta). El cliente nunca sube ni lee este
    // path directo.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
